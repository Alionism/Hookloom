{
  "appId": "app.hookloom.studio",
  "appName": "Hookloom",
  "webDir": "www",
  "backgroundColor": "#0A0A14",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
